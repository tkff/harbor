{
  "name": "harbor-ssh",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:interop": "cargo test --locked --manifest-path src-tauri/Cargo.toml independent_kdbx_interoperability -- --ignored --nocapture",
    "test:terminal": "node --experimental-strip-types scripts/check-terminal-shortcuts.mjs",
    "check:version": "node scripts/check-version.mjs",
    "test:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "hash-wasm": "^4.13.0",
    "kdbxweb": "^2.1.1",
    "prettier": "^3.10.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.0"
  }
}
